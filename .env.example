niNODE_ENV=production
PORT=3000

# From `shopify app env show`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_discounts,read_products,write_products

# Public HTTPS origin of the hosted app (no trailing slash)
SHOPIFY_APP_URL=https://your-service.onrender.com

# Optional. Unset = SQLite file prisma/dev.sqlite (local / ephemeral host disk).
# Postgres example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_URL=file:dev.sqlite
